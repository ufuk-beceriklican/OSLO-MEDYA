---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout title="Sayfa bulunamadı" description="Aradığınız sayfa bulunamadı. Ana sayfaya ya da hizmetlere göz atabilirsiniz." noindex cta={false}>
  <section class="section not-found">
    <div class="container">
      <h1>Bu sayfa yok.</h1>
      <p>Aradığınız adres taşınmış ya da hiç var olmamış olabilir. Ana sayfadan devam edin ya da hizmetlere göz atın.</p>
      <div class="actions">
        <Button href="/" icon="arrow-left">Ana sayfa</Button>
        <Button href="/hizmetler" variant="secondary" icon="arrow-right">Hizmetler</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-top: calc(var(--header-h) + var(--header-top) + clamp(5rem, 12vw, 10rem));
  }

  .not-found p {
    margin-top: 1.5rem;
    font-size: var(--fs-2);
    color: var(--text-2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
</style>
