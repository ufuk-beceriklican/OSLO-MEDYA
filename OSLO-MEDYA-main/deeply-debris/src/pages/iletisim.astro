---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import Button from '../components/ui/Button.astro';
import Field from '../components/ui/Field.astro';
import Icon from '../components/ui/Icon.astro';
import { site } from '../data/site';

const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT;
---

<BaseLayout
  title="İletişim"
  description="Projenizi anlatın: formu doldurun, WhatsApp'tan yazın ya da bizi arayın. Oslo Medya, Aydın merkezli dijital ajans."
  cta={false}
>
  <PageHeader
    title="Projenizi konuşalım"
    lead="Hedeflerinizi, ihtiyacınızı ya da aklınızdaki soruları yazın. Size en kısa sürede dönüş yapalım."
    crumbs={[{ name: 'İletişim', path: '/iletisim' }]}
  />

  <section class="section section--after-header">
    <div class="container contact">
      <aside class="contact__info" aria-label="İletişim bilgileri" data-reveal>
        <dl>
          <div>
            <dt class="label">Telefon</dt>
            <dd>
              <a href={site.contact.phoneHref}>
                <Icon name="phone" size={22} />
                {site.contact.phone}
              </a>
            </dd>
          </div>
          <div>
            <dt class="label">E-posta</dt>
            <dd>
              <a href={`mailto:${site.contact.email}`}>
                <Icon name="envelope-simple" size={22} />
                {site.contact.email}
              </a>
            </dd>
          </div>
          <div>
            <dt class="label">Adres</dt>
            <dd>
              <span>
                <Icon name="map-pin" size={22} />
                {site.contact.address}
              </span>
            </dd>
          </div>
        </dl>
        <Button href={site.contact.whatsapp} external size="lg" icon="whatsapp-logo">WhatsApp'tan yazın</Button>
      </aside>

      <form
        class="contact__form"
        data-contact-form
        data-whatsapp={site.contact.whatsappNumber}
        data-endpoint={endpoint || undefined}
        novalidate
        data-reveal
      >
        <Field label="Ad soyad" name="name" autocomplete="name" required />
        <div class="contact__row">
          <Field label="Telefon" name="phone" type="tel" autocomplete="tel" inputmode="tel" required />
          <Field label="E-posta" name="email" type="email" autocomplete="email" inputmode="email" />
        </div>
        <Field label="Şirket veya marka" name="company" autocomplete="organization" />
        <Field label="Projenizden bahsedin" name="message" multiline rows={6} required />

        <div class="consent" data-consent>
          <label>
            <input type="checkbox" name="consent" required />
            <span>
              <a href="/kvkk" target="_blank" rel="noopener">KVKK aydınlatma metnini</a> okudum; kişisel verilerimin talebime yanıt verilmesi amacıyla işlenmesini kabul ediyorum.
            </span>
          </label>
          <p class="consent__error" data-error role="alert" hidden></p>
        </div>

        <div class="contact__submit">
          <Button type="submit" size="lg" icon="paper-plane-tilt">Mesajı gönder</Button>
          <p class="contact__note">
            {
              endpoint
                ? 'Formu gönderdiğinizde mesajınız doğrudan bize ulaşır.'
                : 'Gönder dediğinizde WhatsApp, mesajınız hazır şekilde açılır; göndermeniz yeterli.'
            }
          </p>
        </div>

        <div class="contact__status" data-form-status role="status" aria-live="polite" hidden></div>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    display: grid;
    gap: 3.5rem;
    align-items: start;
  }

  .contact__info {
    display: grid;
    gap: 2rem;
    justify-items: start;
  }

  .contact__info dl {
    display: grid;
    gap: 1.5rem;
    width: 100%;
  }

  .contact__info dl > div {
    display: grid;
    gap: 0.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--hairline-strong);
  }

  .contact__info dd a,
  .contact__info dd span {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-size: var(--fs-3);
    font-weight: 500;
    letter-spacing: -0.025em;
  }

  .contact__form {
    display: grid;
    gap: 1.25rem;
  }

  .contact__row {
    display: grid;
    gap: 1.25rem;
  }

  .consent label {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.875rem;
    align-items: start;
    font-size: var(--fs-0);
    line-height: 1.55;
    color: var(--text-2);
  }

  .consent input {
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.125rem;
  }

  .consent a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
    color: var(--text);
  }

  .consent__error {
    margin-top: 0.5rem;
    font-size: var(--fs-0);
    font-weight: 500;
    color: var(--danger);
  }

  .contact__submit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  .contact__note {
    flex: 1 1 14rem;
    font-size: var(--fs-0);
    color: var(--text-3);
  }

  .contact__status {
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--r-md);
    background: var(--paper);
    line-height: 1.5;
  }

  .contact__status[data-tone='success'] {
    border-color: var(--success);
  }

  .contact__status[data-tone='error'] {
    border-color: var(--danger);
  }

  .contact__status :global(a) {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (min-width: 48rem) {
    .contact__row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .contact {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 6rem;
    }
  }
</style>
