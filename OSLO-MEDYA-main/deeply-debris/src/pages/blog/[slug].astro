---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRow from '../../components/sections/PostRow.astro';
import Button from '../../components/ui/Button.astro';
import { categorySlugs, getPosts, postPath } from '../../lib/posts';
import { formatDate, isoDate, readingMinutes } from '../../lib/format';
import { articleLd, breadcrumbLd } from '../../lib/seo';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => {
    // Önce aynı kategoriden, sonra en yeni yazılardan iki öneri
    const others = posts.filter((other) => other.id !== post.id);
    const related = [
      ...others.filter((other) => other.data.category === post.data.category),
      ...others.filter((other) => other.data.category !== post.data.category),
    ].slice(0, 2);
    return { params: { slug: post.id }, props: { post, related } };
  });
}

const { post, related } = Astro.props;
const { Content } = await render(post);
const minutes = readingMinutes(post.body ?? '');
const path = postPath(post);
const { title, description, pubDate, updatedDate, category } = post.data;
const crumbs = [
  { name: 'Ana sayfa', path: '/' },
  { name: 'Blog', path: '/blog' },
  { name: title, path },
];
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedTime={isoDate(pubDate)}
  modifiedTime={isoDate(updatedDate ?? pubDate)}
  jsonLd={[
    articleLd({
      title,
      description,
      path,
      datePublished: isoDate(pubDate),
      dateModified: isoDate(updatedDate ?? pubDate),
    }),
    breadcrumbLd(crumbs),
  ]}
>
  <div class="reading-progress" data-reading-progress aria-hidden="true"></div>

  <article data-article>
    <header class="post-header">
      <div class="container post-header__inner">
        <nav class="post-header__crumbs" aria-label="Sayfa yolu">
          <a href="/blog">Blog</a>
          <span aria-hidden="true">/</span>
          <a href={`/blog/kategori/${categorySlugs[category]}`}>{category}</a>
        </nav>
        <h1>{title}</h1>
        <p class="post-header__lead">{description}</p>
        <p class="post-header__meta tnum">
          <time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
          {updatedDate && <span>Güncellendi: <time datetime={isoDate(updatedDate)}>{formatDate(updatedDate)}</time></span>}
          <span>{minutes} dk okuma</span>
        </p>
      </div>
    </header>

    <div class="container prose-grid">
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>

  <section class="section" aria-labelledby="related-title">
    <div class="container">
      <h2 id="related-title" class="related__title">Bunları da okuyun</h2>
      <ul class="related" role="list">
        {related.map((item) => <PostRow post={item} />)}
      </ul>
      <div class="related__more">
        <Button href="/blog" variant="secondary" icon="arrow-right">Tüm yazılar</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: calc(var(--z-header) + 1);
    height: 3px;
    background: var(--ink);
    transform-origin: left;
    transform: scaleX(0);
  }

  .post-header {
    padding-top: calc(var(--header-h) + var(--header-top) + clamp(3rem, 8vw, 7rem));
    padding-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }

  .post-header__crumbs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    font-size: var(--fs-0);
    color: var(--text-3);
  }

  .post-header__crumbs a {
    text-decoration: underline;
    text-decoration-color: var(--hairline-strong);
  }

  .post-header h1 {
    max-width: 22ch;
    font-size: var(--fs-5);
    line-height: 1.02;
  }

  .post-header__lead {
    margin-top: 1.5rem;
    max-width: 40rem;
    font-size: var(--fs-2);
    line-height: 1.5;
    color: var(--text-2);
  }

  .post-header__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1.5rem;
    font-size: var(--fs-0);
    color: var(--text-3);
  }

  .related__title {
    margin-bottom: 2rem;
    font-size: var(--fs-4);
  }

  .related {
    list-style: none;
    padding: 0;
    border-bottom: 1px solid var(--hairline-strong);
  }

  .related__more {
    margin-top: 2rem;
  }
</style>
