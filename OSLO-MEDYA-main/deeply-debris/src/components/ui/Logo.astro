---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={['logo', className]}>
  <span class="logo__mark" aria-hidden="true"><i></i><i></i></span>
  <span class="logo__word">Oslo Medya</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--text);
    line-height: 1;
  }

  /* İşaret: ikiye bölünmüş güneş. Üst yarı aurora, alt yarı yazı rengi. */
  .logo__mark {
    position: relative;
    flex: none;
    width: 1.75rem;
    aspect-ratio: 1;
  }

  .logo__mark i {
    position: absolute;
    inset: 0;
    border-radius: 50%;
  }

  .logo__mark i:first-child {
    background: var(--aurora);
    clip-path: inset(0 0 55% 0);
  }

  .logo__mark i:last-child {
    background: currentColor;
    clip-path: inset(55% 0 0 0);
  }

  .logo__word {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
</style>
