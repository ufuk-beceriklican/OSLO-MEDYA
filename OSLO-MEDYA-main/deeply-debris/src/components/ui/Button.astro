---
import Icon from './Icon.astro';
import type { IconName } from '../../lib/icons';

interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'link';
  size?: 'md' | 'lg';
  /** Sondaki ikon. `null` ikonu kaldırır. */
  icon?: IconName | null;
  /** Yeni sekmede açar (WhatsApp gibi dış bağlantılar). */
  external?: boolean;
  type?: 'button' | 'submit';
  class?: string;
  [attr: string]: unknown;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  icon = 'arrow-up-right',
  external = false,
  type = 'button',
  class: className,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
const attrs = href ? { href, ...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {}) } : { type };
---

<Tag class:list={['btn', `btn--${variant}`, `btn--${size}`, className]} {...attrs} {...rest}>
  <span class="btn__label"><slot /></span>
  {icon && <Icon name={icon} size={size === 'lg' ? 22 : 20} class="btn__icon" />}
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    min-height: 2.875rem;
    padding-inline: 1.375rem;
    border-radius: var(--r-pill);
    font-family: var(--font-body);
    font-size: var(--fs-1);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.005em;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-position var(--dur-slow) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      transform var(--dur-quick) var(--ease-out);
  }

  .btn--lg {
    min-height: 3.375rem;
    padding-inline: 1.75rem;
  }

  /* Birincil: aurora dolgu, mürekkep yazı. Gradient'in üç kullanım yerinden biri. */
  .btn--primary {
    background: var(--aurora);
    background-size: 170% 100%;
    background-position: 0% 50%;
    color: var(--ink);
    border: 0;
  }

  .btn--secondary {
    background: transparent;
    color: var(--text);
    border: 1px solid var(--hairline-strong);
  }

  .btn--link {
    min-height: 2.5rem;
    padding-inline: 0;
    border-radius: var(--r-xs);
    color: var(--text);
    background: linear-gradient(currentColor, currentColor) 0 100% / 100% 1px no-repeat;
    padding-bottom: 0.125rem;
    min-height: 0;
  }

  .btn :global(.btn__icon) {
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .btn:active {
    transform: scale(0.98);
  }

  @media (hover: hover) {
    .btn--primary:hover {
      background-position: 100% 50%;
    }

    .btn--secondary:hover {
      background: var(--text);
      color: var(--surface);
      border-color: var(--text);
    }

    .btn:hover :global(.btn__icon) {
      transform: translate(2px, -2px);
    }
  }
</style>
