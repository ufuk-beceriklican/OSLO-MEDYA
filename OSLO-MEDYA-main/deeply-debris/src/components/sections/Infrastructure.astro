---
import Icon from '../ui/Icon.astro';
import { infrastructure } from '../../data/home';
---

<section class="section infra" aria-labelledby="infra-title">
  <div class="container infra__grid">
    <div class="infra__head">
      <h2 id="infra-title" data-reveal>Altyapı hizmetleri</h2>
      <p data-reveal>Sitenizin hızlı, güvenli ve erişilebilir kalması için gereken teknik temeli de biz kuruyoruz.</p>
    </div>
    <ul class="infra__list" role="list">
      {
        infrastructure.map((item) => (
          <li class="infra__item" data-reveal>
            <Icon name={item.icon} size={32} />
            <div>
              <h3>{item.title}</h3>
              <p>{item.detail}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .infra__grid {
    display: grid;
    gap: 2.5rem var(--col-gap);
  }

  .infra__head {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  .infra__head p {
    font-size: var(--fs-2);
    line-height: 1.5;
    color: var(--text-2);
  }

  .infra__list {
    list-style: none;
    padding: 0;
    border-bottom: 1px solid var(--hairline-strong);
  }

  .infra__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.5rem;
    align-items: start;
    padding-block: 1.75rem;
    border-top: 1px solid var(--hairline-strong);
  }

  .infra__item h3 {
    margin-bottom: 0.375rem;
    font-size: var(--fs-3);
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .infra__item p {
    color: var(--text-2);
  }

  @media (min-width: 56rem) {
    .infra__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: start;
    }

    .infra__head {
      grid-column: 1 / 6;
      position: sticky;
      top: 7rem;
    }

    .infra__list {
      grid-column: 8 / -1;
    }
  }
</style>
