---
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import { site } from '../../data/site';
import aurora from '../../assets/generated/cta-aurora.webp';
---

<section class="cta" aria-labelledby="cta-title">
  <Image
    class="cta__aurora"
    src={aurora}
    alt=""
    widths={[1280, 1920, 2688]}
    sizes="100vw"
    format="webp"
    quality={82}
    loading="lazy"
    decoding="async"
  />
  <div class="container cta__inner">
    <h2 id="cta-title" data-reveal>Projenizi konuşalım.</h2>
    <p data-reveal>Formu doldurun ya da WhatsApp'tan yazın, en kısa sürede size dönüş yapalım.</p>
    <div class="cta__actions" data-reveal>
      <Button href={site.contact.whatsapp} external size="lg">WhatsApp'tan yazın</Button>
      <Button href="/iletisim" variant="secondary" size="lg" icon="arrow-right">İletişim formu</Button>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: clip;
    isolation: isolate;
    padding-block: clamp(7rem, 16vw, 14rem) clamp(9rem, 20vw, 18rem);
  }

  /* Aurora gökyüzü alt kenardan yükselir; üst kenarı gece rengine erir. */
  .cta__aurora {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
    -webkit-mask-image: linear-gradient(to top, #000 55%, transparent 100%);
    mask-image: linear-gradient(to top, #000 55%, transparent 100%);
  }

  .cta__inner {
    display: grid;
    justify-items: start;
    gap: 1.5rem;
  }

  .cta h2 {
    font-size: var(--fs-6);
    line-height: 0.98;
    letter-spacing: -0.03em;
    max-width: 12ch;
  }

  .cta p {
    font-size: var(--fs-2);
    color: var(--text-2);
    max-width: 30rem;
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
</style>
