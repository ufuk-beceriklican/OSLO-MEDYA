---
import Icon from '../ui/Icon.astro';
import { formatDate, isoDate } from '../../lib/format';
import { postPath, type Post } from '../../lib/posts';

interface Props {
  post: Post;
  /** Açıklama satırını gösterir (blog arşivi). */
  excerpt?: boolean;
  /** Başlık seviyesi: sayfanın başlık sırası atlanmasın diye (h1 → h2 → h3) bağlama göre seçilir. */
  level?: 2 | 3;
}
const { post, excerpt = false, level = 3 } = Astro.props;
const Heading = level === 2 ? 'h2' : 'h3';
---

<li class="post-row" data-reveal>
  <a class="post-row__link" href={postPath(post)}>
    <time class="post-row__date tnum" datetime={isoDate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time>
    <div class="post-row__body">
      <Heading class="post-row__title">{post.data.title}</Heading>
      {excerpt && <p>{post.data.description}</p>}
    </div>
    <span class="post-row__category label">{post.data.category}</span>
    <span class="post-row__arrow" aria-hidden="true"><Icon name="arrow-up-right" size={24} /></span>
  </a>
</li>

<style>
  .post-row {
    list-style: none;
    border-top: 1px solid var(--hairline-strong);
  }

  .post-row__link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'date date'
      'body arrow'
      'category category';
    gap: 0.5rem 1.5rem;
    align-items: start;
    padding-block: clamp(1.25rem, 2.2vw, 2rem);
  }

  .post-row__date {
    grid-area: date;
    font-size: var(--fs-0);
    color: var(--text-3);
  }

  .post-row__body {
    grid-area: body;
    display: grid;
    gap: 0.625rem;
  }

  .post-row__title {
    font-size: var(--fs-3);
    line-height: 1.12;
    letter-spacing: -0.025em;
    transition: transform var(--dur-medium) var(--ease-out);
  }

  .post-row__body p {
    max-width: 44rem;
    color: var(--text-2);
  }

  .post-row__category {
    grid-area: category;
  }

  .post-row__arrow {
    grid-area: arrow;
    color: var(--text-3);
    transition:
      color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  @media (min-width: 56rem) {
    .post-row__link {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-areas: none;
      gap: 0 var(--col-gap);
    }

    .post-row__date {
      grid-area: auto;
      grid-column: 1 / 3;
      padding-top: 0.45rem;
    }

    .post-row__body {
      grid-area: auto;
      grid-column: 3 / 10;
    }

    .post-row__category {
      grid-area: auto;
      grid-column: 10 / 12;
      text-align: right;
      padding-top: 0.35rem;
    }

    .post-row__arrow {
      grid-area: auto;
      grid-column: 12 / -1;
      justify-self: end;
    }
  }

  @media (hover: hover) {
    .post-row__link:hover .post-row__title {
      transform: translateX(0.5rem);
    }

    .post-row__link:hover .post-row__arrow {
      color: var(--text);
      transform: translate(2px, -2px);
    }
  }
</style>
