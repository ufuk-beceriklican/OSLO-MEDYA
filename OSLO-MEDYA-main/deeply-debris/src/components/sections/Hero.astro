---
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import { site } from '../../data/site';
import aurora from '../../assets/generated/hero-aurora.webp';

const imageProps = {
  src: aurora,
  alt: '',
  widths: [640, 960, 1280, 1600],
  sizes: '(min-width: 64rem) 50vw, 90vw',
  // Yumuşak gradyanlar için AVIF, WebP'ye göre belirgin biçimde küçüktür
  format: 'avif' as const,
  quality: 62,
  decoding: 'async' as const,
};
---

<section class="hero" data-hero aria-labelledby="hero-title">
  <!-- Bölünmüş güneş: logonun işareti. Açılışta birleşir, kaydırınca aralanır. -->
  <div class="hero__sun" aria-hidden="true">
    <div class="hero__move" data-move="top">
      <div class="hero__half hero__half--top" data-half="top">
        <Image {...imageProps} loading="eager" fetchpriority="high" />
      </div>
    </div>
    <div class="hero__move" data-move="bottom">
      <div class="hero__half hero__half--bottom" data-half="bottom">
        <Image {...imageProps} loading="eager" />
      </div>
    </div>
  </div>

  <div class="container hero__inner" data-hero-content>
    <h1 id="hero-title" class="hero__title">
      <span class="hero__line"><span data-hero-in>Dijital zirveniz</span></span>
      <span class="hero__line"><span data-hero-in>Aydın'dan başlar.</span></span>
    </h1>
    <p class="hero__lead" data-hero-in>
      Web tasarım, SEO, reklam ve sosyal medyada yerel uzmanlıkla işletmenizi Türkiye çapında rekabete hazırlıyoruz.
    </p>
    <div class="hero__actions" data-hero-in>
      <Button href={site.contact.whatsapp} external size="lg">Teklif al</Button>
      <Button href="/hizmetler" variant="secondary" size="lg" icon="arrow-right">Hizmetleri gör</Button>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: min(100svh, 62rem);
    padding-top: calc(var(--header-h) + var(--header-top) + 1.5rem);
    padding-bottom: clamp(3rem, 7vw, 6.5rem);
    overflow: clip;
  }

  .hero__sun {
    --sun: min(82vw, 26rem);
    position: relative;
    width: var(--sun);
    aspect-ratio: 1;
    margin: 1.5rem auto 2.5rem;
  }

  /* Dış halka: güneşin yörüngesi */
  .hero__sun::after {
    content: '';
    position: absolute;
    inset: -2.4%;
    border: 1px solid var(--hairline-strong);
    border-radius: 50%;
    pointer-events: none;
  }

  /* Kaydırma hareketi bu sarmalayıcıda, açılış hareketi yarımın kendisinde: çakışmazlar. */
  .hero__move {
    position: absolute;
    inset: 0;
  }

  .hero__half {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 50%;
    will-change: transform;
  }

  .hero__half--top {
    clip-path: inset(0 0 55% 0);
  }

  .hero__half--bottom {
    clip-path: inset(55% 0 0 0);
  }

  .hero__half :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.25rem);
    justify-items: start;
  }

  .hero__title {
    display: grid;
  }

  /* Satır maskesi: açılışta satırlar aşağıdan yükselir */
  .hero__line {
    display: block;
    overflow: clip;
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }

  .hero__line > span {
    display: block;
  }

  .hero__lead {
    max-width: 34rem;
    font-size: var(--fs-2);
    line-height: 1.5;
    color: var(--text-2);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (min-width: 64rem) {
    .hero {
      padding-top: calc(var(--header-h) + var(--header-top) + 3rem);
    }

    .hero__sun {
      --sun: clamp(30rem, 50vw, 54rem);
      position: absolute;
      top: clamp(4.5rem, 9vh, 7.5rem);
      right: calc(var(--sun) * -0.13);
      margin: 0;
    }
  }
</style>
